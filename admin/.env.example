# Noble Path admin (D-36). Copy to .env.local for local development; set the
# real values only in the hosting platform's secret settings. See
# docs/deployment/admin.md.

# np_admin connection string for Aiven PostgreSQL.
DATABASE_URL=
# Aiven CA certificate: PEM text, or its base64 encoding.
DATABASE_CA_CERT=
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts the TOTP secret.
ADMIN_ENCRYPTION_KEY=
# The public site, e.g. https://noblepath.lk (also read at build time for the CSP).
PUBLIC_SITE_URL=http://localhost:3000
# The public site's deploy hook (a secret). Without it, Publish is disabled.
SITE_DEPLOY_HOOK_URL=
