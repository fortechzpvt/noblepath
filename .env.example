# Noble Path - environment configuration
# Copy to .env.local for local development. NEVER commit .env.local.
# Documented in docs/deployment/environment.md

# Public base URL, used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where booking enquiries are delivered. Server-side only.
BOOKINGS_NOTIFICATION_EMAIL=

# Resend (resend.com) secret API key. Server-side only, required in production.
# Sign up, create a key, and put it here (or in your deployment's env config) —
# never in a committed file.
RESEND_API_KEY=

# The "from" address for outgoing mail. Resend's sandbox sender works with no
# domain verification, but only delivers to the account's own address until a
# sending domain is verified. See docs/deployment/environment.md.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Sliding-window rate limit for the public booking endpoint.
BOOKING_RATE_LIMIT_MAX=5
BOOKING_RATE_LIMIT_WINDOW_MS=600000

# --- D-36/D-37: Supabase PostgreSQL (see docs/deployment/admin.md) -----------
# All optional locally: without them the site uses the bundled content/*.ts and
# only emails enquiries. Never put real connection strings in a committed file.
# Use the Supabase pooler (Connect → Transaction/Session pooler): the direct
# host is IPv6-only. Pooler user names carry the project ref:
#   postgresql://np_site_build.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# BUILD time: np_site_build connection string (reads published content only).
# Session pooler, port 5432.
CONTENT_DATABASE_URL=
# Set to true in production so a build without the database fails safely.
REQUIRE_DATABASE_CONTENT=
# RUN time: np_site_runtime connection string (saves enquiries, counts visits).
# Transaction pooler, port 6543 (serverless functions).
DATABASE_URL=
# Supabase CA (prod-ca-2021.crt, Project Settings → Database → SSL): PEM text,
# or its base64 encoding. Not a secret, but keep the file out of the repository.
DATABASE_CA_CERT=
